[sub_resource type="Resource" id="Resource_hxhn1"]
script = ExtResource("1_sgo0n")
identifier = "Tired Guard"
dialogue = Array[String](["Safety lies in either the door I am guarding or the door across me."])
summary = "Between the left and right door, one is safe"
metadata/_custom_type_script = "uid://b847wsowr1b63"

